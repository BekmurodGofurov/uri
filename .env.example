POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=uzum_reviews
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Required Database Connection Strings
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/uzum_reviews
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/uzum_reviews_test

# Required Microservice URLs
SENTIMENT_SVC_URL=http://localhost:8001
ASPECT_SVC_URL=http://localhost:8002

# Required Gateway Security
API_KEY=changeme-your-secret-key-here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Dashboard Frontend
VITE_API_URL=http://localhost:8000

# Sentiment Service
SENTIMENT_IMAGE=sentiment-svc:v1
SENTIMENT_PORT=8001
MODEL_PATH=models/tfidf_v1.joblib
MODEL_TYPE=tfidf
MODEL_VERSION=sentiment-v1
REGISTRY_ROOT=models
